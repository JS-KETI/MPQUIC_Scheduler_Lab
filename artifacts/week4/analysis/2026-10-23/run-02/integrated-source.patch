+
+void
+QuicL5Protocol::ResumePendingStreams ()
+{
+  for (const auto& stream : m_streams)
+    if (stream->GetStreamId () > 0 &&
+        stream->GetStreamTxAvailable () < stream->GetStreamSndBufSize ())
+      stream->SendPendingData ();
+}
