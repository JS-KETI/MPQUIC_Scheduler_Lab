+QuicL5Protocol::PendingStreamBytes () const
+{
+  uint64_t pending = 0;
+  for (const auto& stream : m_streams)
+    if (stream->GetStreamId () > 0)
+      pending += stream->GetStreamSndBufSize () - stream->GetStreamTxAvailable ();
+  return pending;
