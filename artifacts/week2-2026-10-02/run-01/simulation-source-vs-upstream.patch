+            << g_rxTotal << "," << rx[0] << "," << rx[1] << ","
+            << (np[0] ? 1000 * dsum[0] / np[0] : 0) << ","
+            << (np[1] ? 1000 * dsum[1] / np[1] : 0) << ","
+            << (g_fct < 0 ? 0 : 1) << std::endl;
+
+  Simulator::Destroy ();
+  return 0;
+}
