+  uint64_t rx[2] = {0, 0};
+  double dsum[2] = {0, 0};
+  uint64_t np[2] = {0, 0};
+  for (auto &kv : monitor->GetFlowStats ())
+    {
+      Ipv4FlowClassifier::FiveTuple t = cls->FindFlow (kv.first);
+      int p = -1;
+      if (t.destinationAddress == Ipv4Address ("10.1.5.2")) p = 0;
+      if (t.destinationAddress == Ipv4Address ("10.1.7.2")) p = 1;
+      if (p < 0) continue;
